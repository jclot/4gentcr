{
  "expo": {
    "name": "Virtual Agent",
    "slug": "virtual-agent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": { "backgroundColor": "#0A0A0F" },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Necesitamos acceso a la cámara para fotografiar carteles." }],
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Necesitamos tu ubicación para registrar propiedades." }],
      ["expo-media-library", { "photosPermission": "Acceso a galería para adjuntar fotos." }]
    ],
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0A0A0F" },
      "package": "com.virtualagent.app"
    },
    "ios": {
      "bundleIdentifier": "com.virtualagent.app",
      "supportsTablet": false
    }
  }
}